{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "javac",
      "args": [
        "-cp",
        "lib/miglayout-core-11.4.2.jar;lib/miglayout-swing-11.4.2.jar;lib/mssql-jdbc-12.2.0.jre11.jar",
        "-d",
        "bin",
        "${file}"
      ],
      "problemMatcher": [
        "$javac"
      ]
    },
    {
      "label": "run",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp",
        "bin;lib/miglayout-core-11.4.2.jar;lib/miglayout-swing-11.4.2.jar;lib/mssql-jdbc-12.2.0.jre11.jar",
        "${fileBasenameNoExtension}"
      ],
      "dependsOn": [
        "build"
      ],
      "problemMatcher": []
    }
  ]
}
